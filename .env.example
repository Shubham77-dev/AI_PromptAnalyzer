#
# Supabase Postgres (recommended):
# - DATABASE_URL: pooled (PgBouncer) connection for runtime — port 6543
# - DIRECT_URL: direct connection for Prisma migrations — port 5432
#
# Tips:
# - Use `postgresql://` (not `postgres://`)
# - URL-encode passwords with special chars (e.g. `@` => %40, `$` => %24)
#

# Pooled (runtime — Next.js app)
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Direct (migrations — Prisma CLI)
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Auth (min. 32 characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# OpenAI quality analyzer (optional)
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Ollama Cloud quality analyzer (optional — create key at https://ollama.com/settings/keys)
# Add these to .env or .env.local (NOT this example file) — then restart the dev server.
OLLAMA_API_KEY="your-ollama-api-key"
OLLAMA_MODEL="gpt-oss:120b-cloud"
# OpenAI-compatible base URL (default: https://ollama.com/v1)
# OLLAMA_BASE_URL="https://ollama.com/v1"
# Local Ollama daemon example:
# OLLAMA_BASE_URL="http://localhost:11434/v1"

# Optional: Auth.js (defaults to JWT_SECRET)
# AUTH_SECRET="same-or-different-secret-min-32-chars"
# AUTH_URL="http://localhost:3000"

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Optional: Password reset email (Resend)
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="onboarding@resend.dev"

# Optional: debugging
# ANALYZER_DEBUG="1"
# ANALYZER_PIPELINE_DEBUG="1"
