generator client {
  provider = "prisma-client-js"
}

// Prisma ORM 7: connection URLs are not in this file; see `prisma.config.ts` (CLI/migrate) and `lib/prisma.ts` (runtime `pg` pool from DATABASE_URL).
// Use DATABASE_URL = Supabase pooler (e.g. :6543, `?pgbouncer=true`) for the app; DIRECT_URL = direct Postgres (e.g. :5432) for `migrate` / `db push`.
// After schema changes: `npx prisma migrate dev --name <change>` then `npx prisma migrate deploy` in CI/production.
datasource db {
  provider = "postgresql"
}

enum PromptStatus {
  DRAFT
  PUBLISHED
  UNDER_REVIEW
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
}

enum ModerationStatus {
  APPROVED
  PENDING
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  /// Nullable for OAuth-only accounts (e.g. Google).
  password  String?
  name      String?
  role      UserRole @default(USER)
  status    UserStatus @default(ACTIVE)
  plan      UserPlan @default(FREE)
  createdAt DateTime @default(now())

  prompts             Prompt[]
  likes               Like[]
  usage               DailyUsage[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  /// SHA-256 hex of the raw token from the email link (raw token is never stored).
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Prompt {
  id        String       @id @default(uuid())
  userId    String
  content   String
  status    PromptStatus @default(DRAFT)
  moderationStatus ModerationStatus @default(APPROVED)
  flagged   Boolean      @default(false)
  reason    String?
  /// Combined hybrid analyzer score (0–100). Distinct from moderation API scores on publish.
  score     Float?
  flags     String[]     @default([])
  aiDetails Json?
  moderationScore Float?
  moderationRaw Json?
  /// Six-dimension quality scores from upload preview analyzer.
  qualityDimensions Json?
  promptTypeLabel String?
  maturityLevel String?
  detectedIntent String?
  techStack String[] @default([])
  searchDomain String?
  searchRole String?
  searchKeywords String[] @default([])
  rejectReason String?
  reviewedAt DateTime?
  reviewedById String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis PromptAnalysis?
  stats    PromptStats?
  likes    Like[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([moderationStatus, createdAt])
}

model PromptAnalysis {
  id          String @id @default(uuid())
  promptId    String @unique
  accuracy    Int
  clarity     Int
  suggestions String

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
}

model PromptStats {
  id      String @id @default(uuid())
  promptId String @unique
  likes   Int    @default(0)
  usage   Int    @default(0)

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  promptId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([promptId])
}

model DailyUsage {
  id        String   @id @default(uuid())
  day       DateTime
  userId    String?
  ipHash    String?
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([day, userId])
  @@unique([day, ipHash])
  @@index([userId, day])
  @@index([ipHash, day])
}

model AppConfig {
  id Int @id

  minPublishScore Int @default(60)
  freeTierDailyLimit Int @default(10)

  requireEmailVerification Boolean @default(false)
  allowPublicRegistration Boolean @default(true)
  maintenanceMode Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("app_config")
}

